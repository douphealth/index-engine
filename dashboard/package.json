{
  "name": "index-engine-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:local": "wrangler d1 migrations apply index-engine --local",
    "db:remote": "wrangler d1 migrations apply index-engine --remote",
    "deploy:pages": "wrangler pages deploy",
    "build": "wrangler pages functions build --outdir=./dist/worker",
    "deploy": "npm run build && wrangler deploy --config wrangler.worker.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
